import { print } from "pipi/core";

fn fizzBuzz(limit: number) {
  let n: number = 1;
  while (n <= limit) {
    if (n % 15 == 0) {
      print("fizzbuzz");
    } else if (n % 3 == 0) {
      print("fizz");
    } else if (n % 5 == 0) {
      print("buzz");
    } else {
      print(n);
    }
    n = n + 1;
  }
}

fizzBuzz(18);
